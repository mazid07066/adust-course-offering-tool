generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model academic_terms {
  id                             Int                              @id @default(autoincrement())
  name                           String                           @unique @db.VarChar(100)
  year                           Int
  term_type                      String                           @db.VarChar(30)
  is_active                      Boolean?
  is_current                     Boolean                          @default(false)
  batch_completed_courses        batch_completed_courses[]
  batch_current_registrations    batch_current_registrations[]
  faculty_course_selections      faculty_course_selections[]
  offerings                      offerings[]
  student_semester_registrations student_semester_registrations[]

  semester_archives semester_archives[]
}

model batch_completed_courses {
  id                Int             @id @default(autoincrement())
  batch_id          Int
  academic_term_id  Int?
  course_code       String          @db.VarChar(100)
  course_title      String          @db.VarChar(300)
  normalized_title  String          @db.VarChar(300)
  credit            Float
  grade             String?         @db.VarChar(20)
  source_student_id String?         @db.VarChar(100)
  source_file_name  String?         @db.VarChar(300)
  academic_terms    academic_terms? @relation(fields: [academic_term_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  batches           batches         @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model students {
  id                      Int       @id @default(autoincrement())
  student_id              String    @unique
  full_name               String
  gender                  String?
  date_of_birth           DateTime?
  email                   String?
  phone                   String?
  guardian_name           String?
  guardian_phone          String?
  present_address         String?
  permanent_address       String?
  admission_year          Int?
  admission_term_name     String?
  current_status          String    @default("ACTIVE")
  remarks                 String?
  blood_group             String?
  religion                String?
  nationality             String?
  emergency_contact_name  String?
  emergency_contact_phone String?
  portal_user_id          Int?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  enrollments                    student_program_enrollments[]
  contacts                       student_contacts[]
  status_history                 student_status_history[]
  advisor_assignments            student_advisor_assignments[]
  student_registration_actions   student_registration_actions[]
  student_semester_registrations student_semester_registrations[]

  @@index([student_id])
  @@index([full_name])
  @@index([current_status])
}

model student_program_enrollments {
  id                 Int       @id @default(autoincrement())
  student_id_ref     Int
  program_id         Int
  batch_id           Int?
  curriculum_key     String?
  admission_semester String?   @db.VarChar(100)
  enrollment_status  String    @default("ACTIVE")
  enrolled_at        DateTime  @default(now())
  completed_at       DateTime?
  effective_from     DateTime?
  effective_to       DateTime?
  remarks            String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  students                       students                         @relation(fields: [student_id_ref], references: [id], onDelete: Cascade)
  program                        programs                         @relation(fields: [program_id], references: [id])
  batches                        batches?                         @relation(fields: [batch_id], references: [id])
  student_semester_registrations student_semester_registrations[]

  @@unique([student_id_ref, program_id, batch_id])
  @@index([student_id_ref])
  @@index([program_id])
  @@index([batch_id])
  @@index([curriculum_key])
  @@index([admission_semester])
}

model student_contacts {
  id             Int      @id @default(autoincrement())
  student_id_ref Int
  contact_type   String
  contact_value  String
  is_primary     Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  students students @relation(fields: [student_id_ref], references: [id], onDelete: Cascade)

  @@index([student_id_ref])
  @@index([contact_type])
}

model student_status_history {
  id             Int      @id @default(autoincrement())
  student_id_ref Int
  old_status     String?
  new_status     String
  note           String?
  changed_at     DateTime @default(now())

  students students @relation(fields: [student_id_ref], references: [id], onDelete: Cascade)

  @@index([student_id_ref])
  @@index([new_status])
}

model student_advisor_assignments {
  id             Int       @id @default(autoincrement())
  student_id_ref Int
  teacher_id     Int
  assigned_at    DateTime  @default(now())
  ended_at       DateTime?
  is_active      Boolean   @default(true)
  remarks        String?

  students students @relation(fields: [student_id_ref], references: [id], onDelete: Cascade)
  teachers teachers @relation(fields: [teacher_id], references: [id])

  @@index([student_id_ref])
  @@index([teacher_id])
  @@index([is_active])
}

model batch_current_registrations {
  id                Int            @id @default(autoincrement())
  batch_id          Int
  academic_term_id  Int
  course_code       String         @db.VarChar(100)
  course_title      String         @db.VarChar(300)
  normalized_title  String         @db.VarChar(300)
  credit            Float
  source_student_id String?        @db.VarChar(100)
  source_file_name  String?        @db.VarChar(300)
  academic_terms    academic_terms @relation(fields: [academic_term_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  batches           batches        @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model batches {
  id                             Int                              @id @default(autoincrement())
  program_id                     Int
  batch_code                     String                           @db.VarChar(100)
  admission_term                 String?                          @db.VarChar(100)
  is_active                      Boolean?
  batch_completed_courses        batch_completed_courses[]
  batch_current_registrations    batch_current_registrations[]
  programs                       programs                         @relation(fields: [program_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  offered_course_batches         offered_course_batches[]
  student_program_enrollments    student_program_enrollments[]
  student_semester_registrations student_semester_registrations[]

  @@unique([program_id, batch_code], map: "uq_program_batch")
}

model departments {
  id         Int        @id @default(autoincrement())
  name       String     @unique @db.VarChar(200)
  short_name String     @unique @db.VarChar(50)
  programs   programs[]
  teachers   teachers[]
}

model master_courses {
  id               Int               @id @default(autoincrement())
  program_id       Int
  course_code      String
  course_title     String
  normalized_title String
  credit           Float
  course_type      String
  level_term       String?
  group_name       String?
  is_active        Boolean           @default(true)
  created_at       DateTime          @default(now())
  curriculum_key   String?
  updated_at       DateTime          @default(now()) @updatedAt
  program          programs          @relation(fields: [program_id], references: [id], onDelete: Cascade)
  offered_courses  offered_courses[]

  @@unique([program_id, course_code])
  @@unique([curriculum_key, course_code])
  @@index([curriculum_key])
}

model offered_course_batches {
  id                Int             @id @default(autoincrement())
  offered_course_id Int
  batch_id          Int
  batches           batches         @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  offered_courses   offered_courses @relation(fields: [offered_course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model offered_course_slots {
  id                Int             @id @default(autoincrement())
  offered_course_id Int
  day_of_week       String          @db.VarChar(20)
  start_time        String          @db.VarChar(10)
  end_time          String          @db.VarChar(10)
  room_id           Int
  slot_type         String          @db.VarChar(20)
  offered_courses   offered_courses @relation(fields: [offered_course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rooms             rooms           @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model offered_course_teachers {
  id                Int             @id @default(autoincrement())
  offered_course_id Int
  teacher_id        Int
  assigned_credit   Float
  load_type         String          @db.VarChar(20)
  offered_courses   offered_courses @relation(fields: [offered_course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teachers          teachers        @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model offered_courses {
  id                             Int                              @id @default(autoincrement())
  offering_id                    Int
  master_course_id               Int
  section                        String                           @db.VarChar(20)
  is_cooffered                   Boolean?                         @default(false)
  primary_offered_course_id      Int?
  notes                          String?
  faculty_course_selections      faculty_course_selections[]
  offered_course_batches         offered_course_batches[]
  offered_course_slots           offered_course_slots[]
  offered_course_teachers        offered_course_teachers[]
  master_courses                 master_courses                   @relation(fields: [master_course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  offerings                      offerings                        @relation(fields: [offering_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  offered_course_manual_cooffers offered_course_manual_cooffers[]
  primary_offered_course         offered_courses?                 @relation("offered_course_cooffer_links", fields: [primary_offered_course_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  secondary_offered_courses      offered_courses[]                @relation("offered_course_cooffer_links")
  student_registered_courses     student_registered_courses[]
  student_registration_actions   student_registration_actions[]

  @@index([offering_id, section], map: "ix_offered_courses_offering_section")
  @@index([primary_offered_course_id], map: "ix_offered_courses_primary_offered_course_id")
}

model offerings {
  id                  Int               @id @default(autoincrement())
  academic_term_id    Int
  program_id          Int
  prepared_by_user_id Int
  status              String            @db.VarChar(30)
  created_at          DateTime?         @default(now()) @db.Timestamptz(6)
  offered_courses     offered_courses[]
  academic_terms      academic_terms    @relation(fields: [academic_term_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               users             @relation(fields: [prepared_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programs            programs          @relation(fields: [program_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model faculty_course_selections {
  id                Int             @id @default(autoincrement())
  offered_course_id Int
  teacher_id        Int
  academic_term_id  Int
  priority_order    Int?
  status            String          @db.VarChar(30)
  selected_at       DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?       @default(now()) @updatedAt @db.Timestamptz(6)
  confirmed_at      DateTime?       @db.Timestamptz(6)
  academic_terms    academic_terms  @relation(fields: [academic_term_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  offered_courses   offered_courses @relation(fields: [offered_course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teachers          teachers        @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([offered_course_id, teacher_id], map: "uq_faculty_course_selection")
  @@index([teacher_id], map: "ix_faculty_course_selections_teacher_id")
  @@index([academic_term_id], map: "ix_faculty_course_selections_term_id")
  @@index([status], map: "ix_faculty_course_selections_status")
  @@index([teacher_id, academic_term_id], map: "ix_faculty_course_selections_teacher_term")
}

model programs {
  id                             Int                              @id @default(autoincrement())
  department_id                  Int
  name                           String                           @db.VarChar(200)
  short_name                     String                           @db.VarChar(50)
  batches                        batches[]
  master_courses                 master_courses[]
  offerings                      offerings[]
  departments                    departments                      @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_program_enrollments    student_program_enrollments[]
  student_semester_registrations student_semester_registrations[]

  semester_archives semester_archives[]

  @@unique([department_id, name], map: "uq_program_department_name")
}

model rooms {
  id                   Int                    @id @default(autoincrement())
  room_code            String                 @unique @db.VarChar(100)
  room_type            String                 @db.VarChar(50)
  capacity             Int?
  is_active            Boolean?
  offered_course_slots offered_course_slots[]
}

model student_report_logs {
  id                        Int       @id @default(autoincrement())
  student_id                String    @db.VarChar(100)
  student_name              String?   @db.VarChar(200)
  uploaded_by_user_id       Int
  transcript_filename       String?   @db.VarChar(300)
  registration_filename     String?   @db.VarChar(300)
  latest_completed_semester String?   @db.VarChar(100)
  registration_semester     String?   @db.VarChar(100)
  total_earned_credits      Float?
  gpa                       Float?
  generated_excel_path      String?   @db.VarChar(500)
  created_at                DateTime? @default(now()) @db.Timestamptz(6)
  users                     users     @relation(fields: [uploaded_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_student_report_logs_id")
  @@index([student_id], map: "ix_student_report_logs_student_id")
}

model teachers {
  id                          Int                           @id @default(autoincrement())
  department_id               Int
  teacher_code                String                        @unique @db.VarChar(100)
  full_name                   String                        @db.VarChar(200)
  designation                 String?                       @db.VarChar(150)
  email                       String?                       @db.VarChar(200)
  phone                       String?                       @db.VarChar(50)
  seniority_level             Int?
  is_active                   Boolean?
  faculty_course_selections   faculty_course_selections[]
  offered_course_teachers     offered_course_teachers[]
  departments                 departments                   @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                       users[]
  student_advisor_assignments student_advisor_assignments[]

  @@index([department_id], map: "ix_teachers_department_id")
  @@index([seniority_level], map: "ix_teachers_seniority_level")
}

model users {
  id                           Int                            @id @default(autoincrement())
  username                     String                         @unique(map: "ix_users_username") @db.VarChar(100)
  full_name                    String                         @db.VarChar(200)
  password_hash                String
  role                         String                         @db.VarChar(50)
  is_active                    Boolean?
  teacher_id                   Int?
  created_at                   DateTime?                      @default(now()) @db.Timestamptz(6)
  offerings                    offerings[]
  student_report_logs          student_report_logs[]
  student_registration_actions student_registration_actions[]
  teachers                     teachers?                      @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // ✅ ADD THIS LINE ONLY
  faculty_login_sessions FacultyLoginSession[]

  semester_archives_created   semester_archives[]            @relation("semester_archives_created_by")
  semester_archives_finalized semester_archives[]            @relation("semester_archives_finalized_by")
  archive_reflections_created semester_archive_reflections[] @relation("semester_archive_reflections_created_by")
  archive_reflections_updated semester_archive_reflections[] @relation("semester_archive_reflections_updated_by")

  @@index([id], map: "ix_users_id")
}

model academic_catalog_entries {
  id                 Int      @id @default(autoincrement())
  department_code    String
  department_name    String
  program_code       String   @unique
  program_title      String
  program_type       String
  study_shift        String
  curriculum_version String
  student_id_suffix  String?  @unique
  display_label      String
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now()) @updatedAt
  curriculum_key     String?

  @@index([department_code])
  @@index([program_type])
  @@index([study_shift])
  @@index([curriculum_version])
  @@index([curriculum_key])
}

model SystemSetting {
  id              Int      @id @default(autoincrement())
  settingKey      String   @unique
  settingValue    String
  updatedByUserId Int?
  updatedAt       DateTime @updatedAt
}

model FacultyLoginSession {
  id           Int       @id @default(autoincrement())
  userId       Int
  sessionToken String    @unique
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model offered_course_manual_cooffers {
  id                  Int             @id @default(autoincrement())
  offered_course_id   Int
  target_program_code String?         @db.VarChar(100)
  manual_course_code  String          @db.VarChar(100)
  note                String?         @db.VarChar(300)
  created_at          DateTime        @default(now())
  offered_courses     offered_courses @relation(fields: [offered_course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([offered_course_id], map: "ix_offered_course_manual_cooffers_offered_course_id")
  @@index([target_program_code], map: "ix_offered_course_manual_cooffers_target_program_code")
}

model faculty_login_sessions {
  id            Int       @id @default(autoincrement())
  user_id       Int
  teacher_id    Int?
  session_token String    @unique @db.VarChar(191)
  created_at    DateTime  @default(now())
  expires_at    DateTime
  warned_at     DateTime?
  revoked_at    DateTime?

  @@index([user_id], map: "ix_faculty_login_sessions_user_id")
  @@index([teacher_id], map: "ix_faculty_login_sessions_teacher_id")
  @@index([expires_at], map: "ix_faculty_login_sessions_expires_at")
}

model notifications {
  id                   Int       @id @default(autoincrement())
  recipient_user_id    Int?
  recipient_teacher_id Int?
  event_type           String    @db.VarChar(100)
  title                String    @db.VarChar(200)
  message              String    @db.Text
  is_read              Boolean   @default(false)
  created_by_user_id   Int?
  created_at           DateTime  @default(now())
  read_at              DateTime?

  @@index([recipient_user_id], map: "ix_notifications_recipient_user_id")
  @@index([recipient_teacher_id], map: "ix_notifications_recipient_teacher_id")
  @@index([event_type], map: "ix_notifications_event_type")
  @@index([is_read], map: "ix_notifications_is_read")
}

model student_import_logs {
  id                  Int      @id @default(autoincrement())
  import_type         String   @default("STUDENT_BULK_IMPORT") @db.VarChar(80)
  file_name           String?  @db.Text
  file_size           Int?
  total_rows          Int      @default(0)
  ok_rows             Int      @default(0)
  warning_rows        Int      @default(0)
  error_rows          Int      @default(0)
  committed_rows      Int      @default(0)
  created_students    Int      @default(0)
  updated_students    Int      @default(0)
  created_batches     Int      @default(0)
  created_enrollments Int      @default(0)
  updated_enrollments Int      @default(0)
  skipped_rows        Int      @default(0)
  status              String   @default("STARTED") @db.VarChar(40)
  message             String?  @db.Text
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)

  error_rows_list  student_import_error_rows[]
  change_rows_list student_import_change_rows[]

  @@index([created_at], map: "idx_student_import_logs_created_at")
}

model student_import_error_rows {
  id            Int      @id @default(autoincrement())
  import_log_id Int
  row_number    Int
  student_id    String?  @db.Text
  full_name     String?  @db.Text
  program_code  String?  @db.Text
  batch_code    String?  @db.Text
  status        String   @default("ERROR") @db.VarChar(40)
  issues        String?  @db.Text
  raw_payload   Json?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  import_log student_import_logs @relation(fields: [import_log_id], references: [id], onDelete: Cascade)

  @@index([import_log_id], map: "idx_student_import_error_rows_log_id")
}

model student_import_change_rows {
  id               Int      @id @default(autoincrement())
  import_log_id    Int
  entity_type      String   @db.VarChar(80)
  entity_id        Int
  action           String   @db.VarChar(30)
  previous_payload Json?
  new_payload      Json?
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  import_log student_import_logs @relation(fields: [import_log_id], references: [id], onDelete: Cascade)

  @@index([import_log_id], map: "idx_student_import_change_rows_log_id")
}

model baete_roadmap_items {
  id                 Int      @id @default(autoincrement())
  phase_code         String   @db.VarChar(80)
  phase_title        String   @db.VarChar(200)
  period_label       String?  @db.VarChar(150)
  focus_area         String?
  description        String?
  status             String   @default("PLANNED") @db.VarChar(40)
  display_order      Int      @default(0)
  is_active          Boolean  @default(true)
  created_by_user_id Int?
  updated_by_user_id Int?
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status], map: "ix_baete_roadmap_items_status")
  @@index([display_order], map: "ix_baete_roadmap_items_display_order")
  @@index([is_active], map: "ix_baete_roadmap_items_is_active")
}

model baete_criteria {
  id                       Int      @id @default(autoincrement())
  criterion_code           String   @unique @db.VarChar(50)
  title                    String   @db.VarChar(250)
  description              String?
  weight                   Float    @default(0)
  minimum_acceptable_score Float    @default(3.6)
  display_order            Int      @default(0)
  is_active                Boolean  @default(true)
  created_by_user_id       Int?
  updated_by_user_id       Int?
  created_at               DateTime @default(now()) @db.Timestamptz(6)
  updated_at               DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([display_order], map: "ix_baete_criteria_display_order")
  @@index([is_active], map: "ix_baete_criteria_is_active")
}

model baete_deficiency_rules {
  id                 Int      @id @default(autoincrement())
  rule_name          String   @db.VarChar(120)
  severity_label     String   @db.VarChar(80)
  min_score          Float    @default(0)
  max_score          Float    @default(5)
  color_label        String?  @db.VarChar(80)
  recommended_action String?
  display_order      Int      @default(0)
  is_active          Boolean  @default(true)
  created_by_user_id Int?
  updated_by_user_id Int?
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([min_score, max_score], map: "ix_baete_deficiency_rules_score_range")
  @@index([is_active], map: "ix_baete_deficiency_rules_is_active")
}

model baete_graduate_attributes {
  id                  Int      @id @default(autoincrement())
  po_code             String   @unique @db.VarChar(50)
  graduate_attribute  String   @db.VarChar(250)
  baete_code          String?  @db.VarChar(100)
  assessment_evidence String?
  display_order       Int      @default(0)
  is_active           Boolean  @default(true)
  created_by_user_id  Int?
  updated_by_user_id  Int?
  created_at          DateTime @default(now()) @db.Timestamptz(6)
