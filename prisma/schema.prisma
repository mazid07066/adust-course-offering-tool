  created_at                     DateTime                       @default(now()) @db.Timestamptz(6)
  offered_courses                offered_courses?               @relation(fields: [offered_course_id], references: [id], onUpdate: NoAction, map: "fk_student_registration_actions_offered_course")
  student_semester_registrations student_semester_registrations @relation(fields: [registration_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_student_registration_actions_registration")
  students                       students?                      @relation(fields: [student_id_ref], references: [id], onUpdate: NoAction, map: "fk_student_registration_actions_student")
  users                          users?                         @relation(fields: [performed_by_user_id], references: [id], onUpdate: NoAction, map: "fk_student_registration_actions_user")

  @@index([action_type], map: "ix_student_registration_actions_action_type")
  @@index([created_at], map: "ix_student_registration_actions_created_at")
  @@index([registration_id], map: "ix_student_registration_actions_registration_id")
  @@index([student_id_ref], map: "ix_student_registration_actions_student_id_ref")
}
