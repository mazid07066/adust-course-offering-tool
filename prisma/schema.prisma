model semester_archives {
  id                   Int       @id @default(autoincrement())
  academic_term_id     Int
  program_id           Int
  version              Int       @default(1)
  status               String    @default("DRAFT") @db.VarChar(30)
  snapshot_json        Json
  snapshot_schema      String    @default("semester-archive-v1") @db.VarChar(100)
  archive_note         String?   @db.Text
  created_by_user_id   Int
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  finalized_by_user_id Int?
  finalized_at         DateTime? @db.Timestamptz(6)

  academic_terms    academic_terms                 @relation(fields: [academic_term_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programs          programs                       @relation(fields: [program_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  created_by_user   users                          @relation("semester_archives_created_by", fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  finalized_by_user users?                         @relation("semester_archives_finalized_by", fields: [finalized_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reflections       semester_archive_reflections[]

  @@unique([academic_term_id, program_id, version], map: "uq_semester_archive_version")
  @@index([academic_term_id], map: "ix_semester_archives_academic_term")
  @@index([program_id], map: "ix_semester_archives_program")
  @@index([status], map: "ix_semester_archives_status")
  @@index([created_by_user_id], map: "ix_semester_archives_created_by")
  @@index([finalized_by_user_id], map: "ix_semester_archives_finalized_by")
}

model semester_archive_reflections {
  id                  Int      @id @default(autoincrement())
  semester_archive_id Int
  category            String   @db.VarChar(50)
  title               String   @db.VarChar(250)
  narrative           String   @db.Text
  evidence_json       Json?
  sort_order          Int      @default(0)
  created_by_user_id  Int
  updated_by_user_id  Int?
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)

  semester_archive semester_archives @relation(fields: [semester_archive_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  created_by_user  users             @relation("semester_archive_reflections_created_by", fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updated_by_user  users?            @relation("semester_archive_reflections_updated_by", fields: [updated_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([semester_archive_id], map: "ix_archive_reflections_archive")
  @@index([category], map: "ix_archive_reflections_category")
  @@index([created_by_user_id], map: "ix_archive_reflections_created_by")
  @@index([updated_by_user_id], map: "ix_archive_reflections_updated_by")
}

model student_semester_registrations {
  id                           Int                            @id @default(autoincrement())
  student_id_ref               Int
  enrollment_id                Int?
  academic_term_id             Int
  program_id                   Int
  batch_id                     Int?
  status                       String                         @default("DRAFT") @db.VarChar(40)
  total_credits                Float                          @default(0)
  submitted_at                 DateTime?                      @db.Timestamptz(6)
  advisor_approved_at          DateTime?                      @db.Timestamptz(6)
  coordinator_approved_at      DateTime?                      @db.Timestamptz(6)
  locked_at                    DateTime?                      @db.Timestamptz(6)
  cancelled_at                 DateTime?                      @db.Timestamptz(6)
  remarks                      String?
  created_by_student           Boolean                        @default(true)
  created_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  student_registered_courses   student_registered_courses[]
  student_registration_actions student_registration_actions[]
  academic_terms               academic_terms                 @relation(fields: [academic_term_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_student_semester_registrations_academic_term")
  batches                      batches?                       @relation(fields: [batch_id], references: [id], onUpdate: NoAction, map: "fk_student_semester_registrations_batch")
  student_program_enrollments  student_program_enrollments?   @relation(fields: [enrollment_id], references: [id], onUpdate: NoAction, map: "fk_student_semester_registrations_enrollment")
  programs                     programs                       @relation(fields: [program_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_student_semester_registrations_program")
  students                     students                       @relation(fields: [student_id_ref], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_student_semester_registrations_student")

  @@unique([student_id_ref, academic_term_id, program_id], map: "uq_student_semester_registration_student_term_program")
  @@index([academic_term_id], map: "ix_student_semester_registrations_academic_term_id")
  @@index([batch_id], map: "ix_student_semester_registrations_batch_id")
  @@index([enrollment_id], map: "ix_student_semester_registrations_enrollment_id")
  @@index([program_id], map: "ix_student_semester_registrations_program_id")
  @@index([status], map: "ix_student_semester_registrations_status")
  @@index([student_id_ref], map: "ix_student_semester_registrations_student_id_ref")
  @@index([academic_term_id, status], map: "ix_student_semester_registrations_term_status")
}

model student_registered_courses {
  id                             Int                            @id @default(autoincrement())
  registration_id                Int
  offered_course_id              Int
  course_status                  String                         @default("ADDED") @db.VarChar(40)
  action_type                    String                         @default("ADD") @db.VarChar(30)
  credit                         Float                          @default(0)
  is_retake                      Boolean                        @default(false)
  is_improvement                 Boolean                        @default(false)
  added_at                       DateTime                       @default(now()) @db.Timestamptz(6)
  dropped_at                     DateTime?                      @db.Timestamptz(6)
  remarks                        String?
  created_at                     DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                       @default(now()) @db.Timestamptz(6)
  offered_courses                offered_courses                @relation(fields: [offered_course_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_student_registered_courses_offered_course")
  student_semester_registrations student_semester_registrations @relation(fields: [registration_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_student_registered_courses_registration")

  @@unique([registration_id, offered_course_id], map: "uq_student_registered_course_registration_course")
  @@index([course_status], map: "ix_student_registered_courses_course_status")
  @@index([offered_course_id], map: "ix_student_registered_courses_offered_course_id")
  @@index([registration_id], map: "ix_student_registered_courses_registration_id")
}

model student_registration_actions {
  id                             Int                            @id @default(autoincrement())
  registration_id                Int
  student_id_ref                 Int?
  offered_course_id              Int?
  action_type                    String                         @db.VarChar(50)
  old_status                     String?                        @db.VarChar(40)
  new_status                     String?                        @db.VarChar(40)
  performed_by_user_id           Int?
