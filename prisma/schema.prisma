generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model academic_terms {
  id                          Int                           @id @default(autoincrement())
  name                        String                        @unique @db.VarChar(100)
  year                        Int
  term_type                   String                        @db.VarChar(30)
  is_active                   Boolean?
  batch_completed_courses     batch_completed_courses[]
  batch_current_registrations batch_current_registrations[]
  faculty_course_selections   faculty_course_selections[]
  offerings                   offerings[]
}

model batch_completed_courses {
  id                Int             @id @default(autoincrement())
  batch_id          Int
  academic_term_id  Int?
  course_code       String          @db.VarChar(100)
  course_title      String          @db.VarChar(300)
  normalized_title  String          @db.VarChar(300)
  credit            Float
  grade             String?         @db.VarChar(20)
  source_student_id String?         @db.VarChar(100)
  source_file_name  String?         @db.VarChar(300)
  academic_terms    academic_terms? @relation(fields: [academic_term_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  batches           batches         @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model batch_current_registrations {
  id                Int            @id @default(autoincrement())
  batch_id          Int
  academic_term_id  Int
  course_code       String         @db.VarChar(100)
  course_title      String         @db.VarChar(300)
  normalized_title  String         @db.VarChar(300)
  credit            Float
  source_student_id String?        @db.VarChar(100)
  source_file_name  String?        @db.VarChar(300)
  academic_terms    academic_terms @relation(fields: [academic_term_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  batches           batches        @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model batches {
  id                          Int                           @id @default(autoincrement())
  program_id                  Int
  batch_code                  String                        @db.VarChar(100)
  admission_term              String?                       @db.VarChar(100)
  is_active                   Boolean?
  batch_completed_courses     batch_completed_courses[]
  batch_current_registrations batch_current_registrations[]
  programs                    programs                      @relation(fields: [program_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  offered_course_batches      offered_course_batches[]

  @@unique([program_id, batch_code], map: "uq_program_batch")
}

model departments {
  id         Int        @id @default(autoincrement())
  name       String     @unique @db.VarChar(200)
  short_name String     @unique @db.VarChar(50)
  programs   programs[]
  teachers   teachers[]
}

model master_courses {
  id               Int      @id @default(autoincrement())
  program_id       Int
  curriculum_key   String?
  course_code      String
  course_title     String
  normalized_title String
  credit           Float
  course_type      String
  level_term       String?
  group_name       String?
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  program         programs          @relation(fields: [program_id], references: [id], onDelete: Cascade)
  offered_courses offered_courses[]

  @@unique([program_id, course_code])
  @@unique([curriculum_key, course_code])
  @@index([curriculum_key])
}

model offered_course_batches {
  id                Int             @id @default(autoincrement())
  offered_course_id Int
  batch_id          Int
  batches           batches         @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  offered_courses   offered_courses @relation(fields: [offered_course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model offered_course_slots {
  id                Int             @id @default(autoincrement())
  offered_course_id Int
  day_of_week       String          @db.VarChar(20)
  start_time        String          @db.VarChar(10)
  end_time          String          @db.VarChar(10)
  room_id           Int
  slot_type         String          @db.VarChar(20)
  offered_courses   offered_courses @relation(fields: [offered_course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rooms             rooms           @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model offered_course_teachers {
  id                Int             @id @default(autoincrement())
  offered_course_id Int
  teacher_id        Int
  assigned_credit   Float
  load_type         String          @db.VarChar(20)
  offered_courses   offered_courses @relation(fields: [offered_course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teachers          teachers        @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model offered_courses {
  id                        Int                         @id @default(autoincrement())
  offering_id               Int
  master_course_id          Int
  section                   String                      @db.VarChar(20)
  is_cooffered              Boolean?
  notes                     String?
  faculty_course_selections faculty_course_selections[]
  offered_course_batches    offered_course_batches[]
  offered_course_slots      offered_course_slots[]
  offered_course_teachers   offered_course_teachers[]
  master_courses            master_courses              @relation(fields: [master_course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  offerings                 offerings                   @relation(fields: [offering_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model offerings {
  id                  Int               @id @default(autoincrement())
  academic_term_id    Int
  program_id          Int
  prepared_by_user_id Int
  status              String            @db.VarChar(30)
  created_at          DateTime?         @default(now()) @db.Timestamptz(6)
  offered_courses     offered_courses[]
  academic_terms      academic_terms    @relation(fields: [academic_term_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               users             @relation(fields: [prepared_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programs            programs          @relation(fields: [program_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model faculty_course_selections {
  id                Int             @id @default(autoincrement())
  offered_course_id Int
  teacher_id        Int
  academic_term_id  Int
  status            String          @db.VarChar(30)
  selected_at       DateTime?       @default(now()) @db.Timestamptz(6)
  confirmed_at      DateTime?       @db.Timestamptz(6)
  academic_terms    academic_terms  @relation(fields: [academic_term_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  offered_courses   offered_courses @relation(fields: [offered_course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teachers          teachers        @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([offered_course_id, teacher_id], map: "uq_faculty_course_selection")
  @@index([teacher_id], map: "ix_faculty_course_selections_teacher_id")
  @@index([academic_term_id], map: "ix_faculty_course_selections_term_id")
}

model programs {
  id             Int              @id @default(autoincrement())
  department_id  Int
  name           String           @db.VarChar(200)
  short_name     String           @db.VarChar(50)
  batches        batches[]
  master_courses master_courses[]
  offerings      offerings[]
  departments    departments      @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([department_id, name], map: "uq_program_department_name")
}

model rooms {
  id                   Int                    @id @default(autoincrement())
  room_code            String                 @unique @db.VarChar(100)
  room_type            String                 @db.VarChar(50)
  capacity             Int?
  is_active            Boolean?
  offered_course_slots offered_course_slots[]
}

model student_report_logs {
  id                        Int       @id @default(autoincrement())
  student_id                String    @db.VarChar(100)
  student_name              String?   @db.VarChar(200)
  uploaded_by_user_id       Int
  transcript_filename       String?   @db.VarChar(300)
  registration_filename     String?   @db.VarChar(300)
  latest_completed_semester String?   @db.VarChar(100)
  registration_semester     String?   @db.VarChar(100)
  total_earned_credits      Float?
  gpa                       Float?
  generated_excel_path      String?   @db.VarChar(500)
  created_at                DateTime? @default(now()) @db.Timestamptz(6)
  users                     users     @relation(fields: [uploaded_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_student_report_logs_id")
  @@index([student_id], map: "ix_student_report_logs_student_id")
}

model teachers {
  id                        Int                         @id @default(autoincrement())
  department_id             Int
  teacher_code              String                      @unique @db.VarChar(100)
  full_name                 String                      @db.VarChar(200)
  designation               String?                     @db.VarChar(150)
  email                     String?                     @db.VarChar(200)
  is_active                 Boolean?
  faculty_course_selections faculty_course_selections[]
  offered_course_teachers   offered_course_teachers[]
  departments               departments                 @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                     users[]
}

model users {
  id                  Int                   @id @default(autoincrement())
  username            String                @unique(map: "ix_users_username") @db.VarChar(100)
  full_name           String                @db.VarChar(200)
  password_hash       String
  role                String                @db.VarChar(50)
  is_active           Boolean?
  teacher_id          Int?
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  offerings           offerings[]
  student_report_logs student_report_logs[]
  teachers            teachers?             @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_users_id")
}

model academic_catalog_entries {
  id                 Int      @id @default(autoincrement())
  department_code    String
  department_name    String
  program_code       String   @unique
  program_title      String
  program_type       String
  study_shift        String
  curriculum_version String
  curriculum_key     String?
  student_id_suffix  String?  @unique
  display_label      String
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now()) @updatedAt

  @@index([department_code])
  @@index([program_type])
  @@index([study_shift])
  @@index([curriculum_version])
  @@index([curriculum_key])
}
